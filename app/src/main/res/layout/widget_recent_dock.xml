<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/widget_pill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/widget_pill_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="5dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_category"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_category_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="↓"
                android:textColor="#F2F5F8"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/widget_open_app"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/widget_small_control_background"
                android:contentDescription="@string/widget_open_app"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/recentdock_app_icon" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_app_grid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/widget_app_rows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_app_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/widget_app_1" style="@style/RecentDock_WidgetSlot"><ImageView android:id="@+id/widget_icon_1" style="@style/RecentDock_WidgetIcon"/><TextView android:id="@+id/widget_label_1" style="@style/RecentDock_WidgetLabel"/></LinearLayout>
                    <LinearLayout android:id="@+id/widget_app_2" style="@style/RecentDock_WidgetSlot"><ImageView android:id="@+id/widget_icon_2" style="@style/RecentDock_WidgetIcon"/><TextView android:id="@+id/widget_label_2" style="@style/RecentDock_WidgetLabel"/></LinearLayout>
                    <LinearLayout android:id="@+id/widget_app_3" style="@style/RecentDock_WidgetSlot"><ImageView android:id="@+id/widget_icon_3" style="@style/RecentDock_WidgetIcon"/><TextView android:id="@+id/widget_label_3" style="@style/RecentDock_WidgetLabel"/></LinearLayout>
                    <LinearLayout android:id="@+id/widget_app_4" style="@style/RecentDock_WidgetSlot"><ImageView android:id="@+id/widget_icon_4" style="@style/RecentDock_WidgetIcon"/><TextView android:id="@+id/widget_label_4" style="@style/RecentDock_WidgetLabel"/></LinearLayout>
                    <LinearLayout android:id="@+id/widget_app_5" style="@style/RecentDock_WidgetSlot"><ImageView android:id="@+id/widget_icon_5" style="@style/RecentDock_WidgetIcon"/><TextView android:id="@+id/widget_label_5" style="@style/RecentDock_WidgetLabel"/></LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_app_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="1dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout android:id="@+id/widget_app_6" style="@style/RecentDock_WidgetSlot"><ImageView android:id="@+id/widget_icon_6" style="@style/RecentDock_WidgetIcon"/><TextView android:id="@+id/widget_label_6" style="@style/RecentDock_WidgetLabel"/></LinearLayout>
                    <LinearLayout android:id="@+id/widget_app_7" style="@style/RecentDock_WidgetSlot"><ImageView android:id="@+id/widget_icon_7" style="@style/RecentDock_WidgetIcon"/><TextView android:id="@+id/widget_label_7" style="@style/RecentDock_WidgetLabel"/></LinearLayout>
                    <LinearLayout android:id="@+id/widget_app_8" style="@style/RecentDock_WidgetSlot"><ImageView android:id="@+id/widget_icon_8" style="@style/RecentDock_WidgetIcon"/><TextView android:id="@+id/widget_label_8" style="@style/RecentDock_WidgetLabel"/></LinearLayout>
                    <LinearLayout android:id="@+id/widget_app_9" style="@style/RecentDock_WidgetSlot"><ImageView android:id="@+id/widget_icon_9" style="@style/RecentDock_WidgetIcon"/><TextView android:id="@+id/widget_label_9" style="@style/RecentDock_WidgetLabel"/></LinearLayout>
                    <LinearLayout android:id="@+id/widget_app_10" style="@style/RecentDock_WidgetSlot"><ImageView android:id="@+id/widget_icon_10" style="@style/RecentDock_WidgetIcon"/><TextView android:id="@+id/widget_label_10" style="@style/RecentDock_WidgetLabel"/></LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:paddingHorizontal="10dp"
                android:textColor="#D7DEE7"
                android:textSize="10sp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_page_controls"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/widget_page_single_down"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_navigation_background"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_widget_chevron_right"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
