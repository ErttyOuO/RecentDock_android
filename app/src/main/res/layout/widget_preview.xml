<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:background="@drawable/widget_pill_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_category_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="★"
            android:textColor="#F2F5F8"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_small_control_background"
            android:contentDescription="@string/widget_open_app"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/recentdock_app_icon" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <LinearLayout style="@style/RecentDock_WidgetSlot"><ImageView style="@style/RecentDock_WidgetIcon" android:background="@drawable/widget_preview_app"/><TextView style="@style/RecentDock_WidgetLabel" android:text="Phone"/></LinearLayout>
            <LinearLayout style="@style/RecentDock_WidgetSlot"><ImageView style="@style/RecentDock_WidgetIcon" android:background="@drawable/widget_preview_app"/><TextView style="@style/RecentDock_WidgetLabel" android:text="Chat"/></LinearLayout>
            <LinearLayout style="@style/RecentDock_WidgetSlot"><ImageView style="@style/RecentDock_WidgetIcon" android:background="@drawable/widget_preview_app"/><TextView style="@style/RecentDock_WidgetLabel" android:text="Game"/></LinearLayout>
            <LinearLayout style="@style/RecentDock_WidgetSlot"><ImageView style="@style/RecentDock_WidgetIcon" android:background="@drawable/widget_preview_app"/><TextView style="@style/RecentDock_WidgetLabel" android:text="News"/></LinearLayout>
            <LinearLayout style="@style/RecentDock_WidgetSlot"><ImageView style="@style/RecentDock_WidgetIcon" android:background="@drawable/widget_preview_app"/><TextView style="@style/RecentDock_WidgetLabel" android:text="Photos"/></LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="1dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <LinearLayout style="@style/RecentDock_WidgetSlot"><ImageView style="@style/RecentDock_WidgetIcon" android:background="@drawable/widget_preview_app"/><TextView style="@style/RecentDock_WidgetLabel" android:text="Music"/></LinearLayout>
            <LinearLayout style="@style/RecentDock_WidgetSlot"><ImageView style="@style/RecentDock_WidgetIcon" android:background="@drawable/widget_preview_app"/><TextView style="@style/RecentDock_WidgetLabel" android:text="Maps"/></LinearLayout>
            <LinearLayout style="@style/RecentDock_WidgetSlot"><ImageView style="@style/RecentDock_WidgetIcon" android:background="@drawable/widget_preview_app"/><TextView style="@style/RecentDock_WidgetLabel" android:text="Drive"/></LinearLayout>
            <LinearLayout style="@style/RecentDock_WidgetSlot"><ImageView style="@style/RecentDock_WidgetIcon" android:background="@drawable/widget_preview_app"/><TextView style="@style/RecentDock_WidgetLabel" android:text="Video"/></LinearLayout>
            <LinearLayout style="@style/RecentDock_WidgetSlot"><ImageView style="@style/RecentDock_WidgetIcon" android:background="@drawable/widget_preview_app"/><TextView style="@style/RecentDock_WidgetLabel" android:text="Tools"/></LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_navigation_background"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_widget_chevron_right" />
</LinearLayout>
