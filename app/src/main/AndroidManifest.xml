<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Special app-access permission. The user must explicitly enable it in Settings. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Only ask Android to expose apps that have a launcher entry. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".RecentDockApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/recentdock_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/recentdock_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.RecentDock">

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.RecentDock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.UsageAccessActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.RecentDock" />

        <activity
            android:name=".analytics.AnalyticsActivity"
            android:exported="false"
            android:theme="@style/Theme.RecentDock" />

        <activity
            android:name=".analytics.AnalyticsLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.RecentDock.TransparentLaunch" />

        <activity
            android:name=".ui.AppDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.RecentDock" />

        <activity
            android:name=".ui.RecentAppsActivity"
            android:exported="false"
            android:theme="@style/Theme.RecentDock" />


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RecentDock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <receiver
            android:name=".widget.RecentAppsWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_apps_widget_info" />
        </receiver>
    </application>

</manifest>
